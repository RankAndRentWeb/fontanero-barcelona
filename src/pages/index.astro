---
import SiteLayout from '../layouts/SiteLayout.astro';
import Index from '../components/_Index.tsx';
import heroImg from '../assets/hero-pintores-valencia.webp';
import featureImg from '../assets/pintor-profesional-valencia.jpg';
---

<SiteLayout 
  title="Reformas en Valencia: Integrales, Cocinas y Baños | Presupuesto"
  description="Especialistas en reformas en Valencia. 🏠 Reformas integrales de pisos, cocinas y baños con acabados profesionales y precios cerrados. ¡Pide presupuesto gratis!"
  canonical="https://mejoresreformasvalencia.es/"
  preloadImages={[heroImg.src]}
>
  <Index client:load heroImage={heroImg} featureImage={featureImg} />
</SiteLayout>
