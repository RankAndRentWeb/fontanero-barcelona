---
import SiteLayout from '../layouts/SiteLayout.astro';
import Index from '../components/_Index.tsx';
import heroImg from '../assets/hero-pintores-valencia.webp';
import featureImg from '../assets/pintor-profesional-valencia.jpg';
---

<SiteLayout 
  title="Empresa de Reformas en Valencia | Reformas Integrales y Presupuesto"
  description="Empresa de reformas en Valencia especializada en reformas integrales, cocinas, baños y pisos. Presupuesto rápido, trabajo profesional y acabado cuidado."
  preloadImages={[heroImg.src]}
>
  <Index client:load heroImage={heroImg} featureImage={featureImg} />
</SiteLayout>
