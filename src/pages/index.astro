---
import SiteLayout from '../layouts/SiteLayout.astro';
import Index from '../components/_Index.tsx';
import heroImg from '../assets/hero-pintores-valencia.webp';
import featureImg from '../assets/pintor-profesional-valencia.jpg';
---

<SiteLayout 
  title="Empresa de Reformas en Valencia | Presupuesto Gratis"
  description="Empresa de reformas en Valencia para cocinas, baños, pisos y reformas integrales. Presupuesto gratis, trabajo profesional y acabados de calidad."
  canonical="https://mejoresreformasvalencia.es/"
  preloadImages={[heroImg.src]}
>
  <Index client:load heroImage={heroImg} featureImage={featureImg} />
</SiteLayout>
