---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import reformaPisoImg from '../../../assets/instalacion-papel-pintado-vinilos-decorativos-valencia.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://mejoresreformasvalencia.es/servicios/reformas-pisos-valencia/#service",
  "name": "Reformas de Pisos en Valencia",
  "description": "Servicio de reformas de pisos en Valencia con reforma parcial o integral, redistribución, cocina, baño, suelos e instalaciones.",
  "url": "https://mejoresreformasvalencia.es/servicios/reformas-pisos-valencia/",
  "serviceType": "Reformas de pisos",
  "areaServed": {
    "@type": "City",
    "name": "Valencia",
    "addressCountry": "ES"
  },
  "provider": {
    "@id": "https://mejoresreformasvalencia.es/#business"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta reformar un piso en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende de metros, estado inicial y calidades. Una reforma parcial puede partir desde 12.000€, y una reforma integral de piso en Valencia suele moverse desde 22.000€ en adelante. Te damos presupuesto cerrado sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de piso?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma parcial suele tardar entre 3 y 5 semanas. Una reforma integral de piso en Valencia puede durar entre 6 y 10 semanas según alcance y redistribución de espacios. Planificamos plazos claros desde el inicio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma integral de piso?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye demolición, albañilería, fontanería, electricidad, suelos, revestimientos, carpintería, acabados finales y renovación de cocina y baño si está en el alcance del proyecto."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacéis redistribución de espacios y reforma de cocina y baño?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Realizamos redistribución de espacios y renovamos cocina y baño dentro de la reforma de piso. Coordinamos todos los gremios para ejecutar la obra de forma ordenada y con acabados duraderos."
      }
    },
    {
      "@type": "Question",
      "name": "¿Trabajáis en Valencia capital y alrededores?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, trabajamos en Valencia capital y alrededores. Realizamos visita técnica y presupuesto sin compromiso para valorar tu piso y definir la mejor propuesta de reforma."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reformas de Pisos en Valencia | Presupuesto Gratis"
  description="Empresa especializada en reformas de pisos en Valencia. Reforma parcial o integral, cocina, baño, suelos e instalaciones con presupuesto gratis."
  keywords="reformas pisos valencia, reforma de pisos valencia, reforma integral de piso en valencia, reformas de pisos en valencia, reformar tu piso en valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reformas-pisos-valencia/"
  schema={[serviceSchema, faqSchema]}
  ogImage="/og-home.webp"
>
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reformas de Pisos" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reformas de Pisos en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Reforma parcial o integral de pisos con coordinación de gremios, mejora de cocina y baño, y acabados duraderos</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 12.000€ <span class="text-sm text-gray-500 font-normal">Reforma parcial</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Coordinación de gremios</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Presupuesto claro</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Acabados duraderos</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={reformaPisoImg.src} alt="Reforma integral de piso en Valencia con acabados modernos" width={reformaPisoImg.width} height={reformaPisoImg.height} class="w-full h-auto object-cover" loading="lazy">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio Reformas Pisos Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Reformas de Pisos en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente según alcance, metros y calidades
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de reformar un piso en Valencia</strong> depende del tamaño de la vivienda, el estado inicial, la redistribución de espacios y las calidades elegidas. En todos los casos trabajamos con presupuesto cerrado y planificación por fases.
            </p>
            
            <p class="text-lg leading-relaxed">
              Como empresa de reformas de pisos en Valencia, coordinamos albañilería, fontanería, electricidad, suelos, revestimientos y carpintería. También renovamos cocina y baño dentro del mismo proyecto para una modernización completa de la vivienda.
            </p>
          </div>

          <!-- Tabla de precios orientativos -->
          <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Reformas de Pisos en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por alcance -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Tipo de Reforma</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma parcial piso 70m²</span>
                    <span class="font-bold text-accent">desde 12.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma integral de piso en Valencia (70m²)</span>
                    <span class="font-bold text-accent">desde 22.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma integral de piso en Valencia (90m²)</span>
                    <span class="font-bold text-accent">desde 29.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye materiales, mano de obra y gestión de obra</p>
              </div>

              <!-- Precio por partidas -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Partidas Habituales</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma cocina completa</span>
                    <span class="font-bold text-accent">desde 8.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma baño completo</span>
                    <span class="font-bold text-accent">desde 4.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Instalaciones completas</span>
                    <span class="font-bold text-accent">desde 6.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según calidades</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye una Reforma de Piso?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Demolición y retirada de materiales</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Albañilería y redistribución de espacios</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Fontanería y electricidad</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Suelos y revestimientos</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Cocina y baño dentro del proyecto</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Limpieza final y garantía</span>
                </div>
              </div>
            </div>

          <div class="mt-8 bg-white rounded-xl p-6">
            <p class="text-lg text-gray-700 mb-6">
              <strong>¿Quieres renovar tu vivienda al completo?</strong> Consulta nuestro <strong>presupuesto de reformas de pisos en Valencia</strong> y te ayudamos a planificar una reforma realista, funcional y bien ejecutada.
            </p>
            <div class="flex justify-center text-center">
              <a href="/contacto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent text-white hover:bg-accent/90 focus:ring-accent shadow-md hover:shadow-lg px-8 py-3 text-lg rounded-lg">
                Solicitar Presupuesto Gratuito
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso Reforma Pisos Valencia -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-green-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Cómo Reformamos Pisos en Valencia
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Proceso paso a paso con planificación y coordinación profesional
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <!-- Paso 1 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  1
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Visita Técnica y Definición del Proyecto</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Realizamos visita al piso para analizar estado, necesidades y objetivos. Definimos alcance, distribución y calidades para una <strong>reforma de pisos en Valencia</strong> alineada con tu presupuesto.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  2
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Plan de Obra y Presupuesto Cerrado</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Entregamos un presupuesto detallado por partidas y calendario de ejecución. Así sabes qué se hace, cuándo se hace y cuánto cuesta cada fase, sin sorpresas.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    Coordinamos recursos y tiempos para que la obra avance de forma ordenada.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  3
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Demolición y Redistribución</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Ejecutamos derribos controlados, albañilería y redistribución de espacios cuando el proyecto lo requiere, mejorando funcionalidad y circulación interior.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    Esta fase permite adaptar el piso a las necesidades reales de uso diario.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  4
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Instalaciones y Acabados</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Renovamos fontanería y electricidad, colocamos suelos y revestimientos, y ejecutamos acabados en cocina y baño para una modernización completa de la vivienda.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 5 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  5
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Control de Calidad y Entrega</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Revisamos todos los remates, corregimos detalles y verificamos funcionamiento de instalaciones. Entregamos el piso limpio y listo para entrar.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 6 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  6
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Postventa y Garantía</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Incluimos garantía por escrito y acompañamiento post-obra para resolver cualquier ajuste final.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios de Reformar un Piso en Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Beneficios de Reformar tu Piso en Valencia
            </h2>
            <p class="text-xl text-gray-600">
              Más funcionalidad, mejor estética y mayor valor para tu vivienda
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-10">
            <!-- Beneficio 1 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-6">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-2">Mejor Distribución del Espacio</h3>
                  <p class="text-gray-700">
                    Una <strong>reforma integral de piso en Valencia</strong> permite adaptar la vivienda a tu forma de vivir, ganando amplitud útil y mejorando la circulación entre estancias.
                  </p>
                </div>
              </div>
            </div>

            <!-- Beneficio 2 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-6">
              <div class="flex items-start space-x-4">
