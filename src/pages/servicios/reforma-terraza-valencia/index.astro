const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta reformar una terraza en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de una reforma de terraza en Valencia depende del tamaño, estado inicial y tipo de acabados. Como referencia, una terraza pequeña puede partir desde 1.800€, una terraza media desde 3.200€ y una reforma integral desde 5.500€. Te damos presupuesto cerrado y sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma de terraza suele tardar entre 4 y 10 días laborables según los trabajos: preparación de base, impermeabilización, pavimento exterior, drenaje y acabados. Si se añade cerramiento o soluciones especiales, puede requerir más tiempo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma de terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye diagnóstico inicial, preparación de superficie, impermeabilización, mejora de drenaje, instalación de suelos exteriores resistentes y remates finales. Si lo necesitas, también realizamos cerramientos para ganar uso y confort durante todo el año."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacéis impermeabilización, suelos y cerramientos en Valencia y alrededores?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Realizamos reformas de terrazas en Valencia capital y alrededores, incluyendo impermeabilización, pavimentos exteriores, drenaje y cerramientos según cada proyecto."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reforma de Terrazas en Valencia | Presupuesto Gratis"
  description="Empresa especializada en reforma de terrazas en Valencia. Suelos, impermeabilización, cerramientos y mejora del espacio exterior con presupuesto gratis."
  keywords="reforma terraza valencia, reformas terrazas valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reforma-terraza-valencia"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reforma de Terrazas" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reforma de Terrazas en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Mejoramos tu terraza con pavimentos resistentes, impermeabilización y soluciones funcionales para disfrutar del espacio exterior todo el año</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 1.800€ <span class="text-sm text-gray-500 font-normal">Proyecto completo</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/presupuesto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Impermeabilización duradera</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Suelos exteriores resistentes</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Presupuesto claro</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={fachadaExteriorImg.src} alt="Reforma de terraza en Valencia con mejora de suelos e impermeabilización" width={fachadaExteriorImg.width} height={fachadaExteriorImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio reforma terrazas Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Reforma de Terrazas en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente según estado, tamaño y acabados
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de reforma terraza Valencia</strong> depende de los metros cuadrados, estado del soporte, sistema de impermeabilización, tipo de pavimento exterior y si se incluye cerramiento. En todos los casos trabajamos con presupuesto cerrado y planificación clara.
            </p>
            
            <p class="text-lg leading-relaxed">
              Como empresa local, ejecutamos una mejora integral de terrazas: reparación de base, drenaje, impermeabilización, instalación de suelos exteriores y remates finales. El objetivo es una terraza cómoda, estética y duradera para uso diario.
            </p>
          </div>

          <!-- Tabla de precios orientativos -->
          <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Reformas de Terrazas en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por superficie -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Tipo de Terraza</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza 20 m²</span>
                    <span class="font-bold text-accent">desde 1.800€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza 30 m²</span>
                    <span class="font-bold text-accent">desde 3.200€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza 40 m²</span>
                    <span class="font-bold text-accent">desde 5.500€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye impermeabilización, pavimento y remates</p>
              </div>

              <!-- Precio por zonas -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Zonas Específicas</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Impermeabilización completa</span>
                    <span class="font-bold text-accent">desde 900€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Pavimento exterior resistente</span>
                    <span class="font-bold text-accent">desde 650€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cerramiento de terraza</span>
                    <span class="font-bold text-accent">desde 1.400€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según estado</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye una Reforma de Terraza?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Inspección técnica y asesoramiento</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Preparación y nivelación de base</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Reparación de grietas y puntos de humedad</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Sistema de impermeabilización</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Instalación de pavimento exterior</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Remates, limpieza y garantía</span>
                </div>
              </div>
            </div>

          <div class="mt-8 bg-white rounded-xl p-6">
            <p class="text-lg text-gray-700 mb-6">
              <strong>¿Quieres aprovechar mejor tu terraza?</strong> Consulta nuestro <strong>precio de reforma de terrazas en Valencia</strong> y te preparamos una propuesta clara, realista y sin compromiso.
            </p>
            <div class="flex justify-center text-center">
              <a href="/presupuesto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent text-white hover:bg-accent/90 focus:ring-accent shadow-md hover:shadow-lg px-8 py-3 text-lg rounded-lg">
                Solicitar Presupuesto Gratuito
              </a>
            </div>
          </div>
          </div>
