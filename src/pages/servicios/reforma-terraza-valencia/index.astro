---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import terrazaHeroImg from '../../../assets/reformas-terrazas-valencia.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://mejoresreformasvalencia.es/servicios/reforma-terraza-valencia/#service",
  "name": "Reforma de Terrazas en Valencia",
  "description": "Servicio de reforma de terrazas en Valencia con impermeabilización, renovación de suelos exteriores, cerramientos y mejoras de confort para uso diario.",
  "url": "https://mejoresreformasvalencia.es/servicios/reforma-terraza-valencia/",
  "serviceType": "Reforma de terrazas",
  "areaServed": {
    "@type": "City",
    "name": "Valencia",
    "addressCountry": "ES"
  },
  "provider": {
    "@id": "https://mejoresreformasvalencia.es/#business"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta reformar una terraza en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de una reforma de terraza en Valencia depende del tamaño, estado inicial y tipo de acabados. Como referencia, una terraza pequeña puede partir desde 1.800€, una terraza media desde 3.200€ y una reforma integral desde 5.500€. Te damos presupuesto cerrado y sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma de terraza suele tardar entre 4 y 10 días laborables según los trabajos: preparación de base, impermeabilización, pavimento exterior, drenaje y acabados. Si se añade cerramiento o soluciones especiales, puede requerir más tiempo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma de terraza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye diagnóstico inicial, preparación de superficie, impermeabilización, mejora de drenaje, instalación de suelos exteriores resistentes y remates finales. Si lo necesitas, también realizamos cerramientos para ganar uso y confort durante todo el año."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacéis impermeabilización, suelos y cerramientos en Valencia y alrededores?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Realizamos reformas de terrazas en Valencia capital y alrededores, incluyendo impermeabilización, pavimentos exteriores, drenaje y cerramientos según cada proyecto."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reforma de Terrazas en Valencia | Presupuesto Gratis"
  description="Empresa especializada en reforma de terrazas en Valencia. Impermeabilización, suelos exteriores, cerramientos, pérgolas e iluminación exterior con presupuesto gratis."
  keywords="reforma de terrazas en valencia, impermeabilización terrazas valencia, cerramientos de terraza valencia, suelos exteriores valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reforma-terraza-valencia/"
  schema={[serviceSchema, faqSchema]}
  ogImage="/og-home.webp"
>

    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reforma de Terrazas" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reforma de Terrazas en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Transformamos tu terraza con impermeabilización, suelos exteriores, cerramientos, pérgolas e iluminación para disfrutarla todo el año.</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 1.800€ <span class="text-sm text-gray-500 font-normal">Reforma de terraza básica</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Impermeabilización y drenaje</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Suelos exteriores y cerramientos</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Presupuesto cerrado y garantía</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={terrazaHeroImg.src} alt="Reforma de terraza en Valencia con mejora de suelos e impermeabilización" width={terrazaHeroImg.width} height={terrazaHeroImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio reforma terrazas Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Reforma de Terrazas en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente según metros, estado y nivel de acabados
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de una reforma de terraza en Valencia</strong> depende de los metros cuadrados, el estado del soporte, el sistema de impermeabilización, el tipo de pavimento exterior y si se incluye cerramiento o pérgola.
            </p>
            
            <p class="text-lg leading-relaxed">
              En todos los casos trabajamos con presupuesto cerrado y planificación clara: preparación de base, drenaje, impermeabilización, instalación de suelos exteriores, iluminación y remates finales.
            </p>
          </div>

          <!-- Tabla de precios orientativos -->
          <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Reformas de Terrazas en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por superficie -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Tipo de Terraza</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza pequeña (hasta 15 m²)</span>
                    <span class="font-bold text-accent">desde 1.800€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza media (15-30 m²)</span>
                    <span class="font-bold text-accent">desde 3.200€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Terraza grande (+30 m²)</span>
                    <span class="font-bold text-accent">desde 5.500€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye impermeabilización, pavimento exterior y remates</p>
              </div>

              <!-- Precio por zonas -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Zonas Específicas</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Impermeabilización completa</span>
                    <span class="font-bold text-accent">desde 900€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Pavimento exterior antideslizante</span>
                    <span class="font-bold text-accent">desde 650€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cerramiento o pérgola ligera</span>
                    <span class="font-bold text-accent">desde 1.400€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según estado y materiales</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye una Reforma de Terraza?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Inspección técnica y planificación</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Preparación y nivelación de base</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Impermeabilización y mejora de drenaje</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Instalación de pavimento exterior</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Cerramientos, pérgolas e iluminación exterior</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Remates, limpieza y garantía por escrito</span>
                </div>
              </div>
            </div>

          <div class="mt-8 bg-white rounded-xl p-6">
            <p class="text-lg text-gray-700 mb-6">
              <strong>¿Quieres aprovechar mejor tu terraza?</strong> Consulta nuestro <strong>precio de reforma de terrazas en Valencia</strong> y te preparamos una propuesta clara y sin compromiso.
            </p>
            <div class="flex justify-center text-center">
              <a href="/contacto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent text-white hover:bg-accent/90 focus:ring-accent shadow-md hover:shadow-lg px-8 py-3 text-lg rounded-lg">
                Solicitar Presupuesto Gratuito
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo Reformamos Terrazas en Valencia: Proceso Profesional -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-green-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Cómo Reformamos tu Terraza en Valencia
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Proceso paso a paso para lograr un espacio exterior funcional, estético y duradero
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <!-- Paso 1 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  1
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Visita y Planificación de la Reforma</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Analizamos el estado de la terraza, tomamos medidas y definimos contigo distribución, materiales y acabados. Te entregamos un plan de obra claro y realista.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  2
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Preparación y Demolición Controlada</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Retiramos elementos deteriorados, preparamos la base y corregimos desniveles para dejar el soporte listo antes de impermeabilizar y colocar los nuevos acabados.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    Esta fase evita patologías futuras y mejora la durabilidad de toda la reforma.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  3
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Impermeabilización y Base Técnica</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Aplicamos el sistema de impermeabilización adecuado y mejoramos pendientes o puntos de evacuación para evitar acumulaciones de agua y filtraciones.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    Trabajamos con materiales resistentes al sol, lluvia y cambios de temperatura para un rendimiento prolongado.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  4
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Instalación de Suelos, Cerramientos y Elementos</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Colocamos pavimentos exteriores antideslizantes y de bajo mantenimiento. Si lo necesitas, incorporamos cerramientos, pérgolas e iluminación exterior para ganar confort y uso diario.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 5 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  5
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Acabados Finales y Entrega</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Revisamos acabados, juntas, drenaje e iluminación. Entregamos la terraza limpia, lista para usar y con garantía por escrito.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios Reforma Terrazas Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Beneficios de Reformar tu Terraza en Valencia
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Más confort, mejor estética y mayor aprovechamiento del espacio exterior
          </p>
        </div>
        
        <div class="max-w-5xl mx-auto">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Beneficio 1 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-8 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Protección frente a Humedad e Intemperie</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Una buena impermeabilización evita filtraciones, humedades y daños en la vivienda. Es la base para que la terraza se mantenga en buen estado durante años.
                  </p>
                </div>
              </div>
            </div>

            <!-- Beneficio 2 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-8 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Más Aprovechamiento del Espacio Exterior</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Una terraza bien distribuida se convierte en una zona útil para descanso, comidas o reuniones durante gran parte del año.
                  </p>
                </div>
              </div>
            </div>

            <!-- Beneficio 3 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-8 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
