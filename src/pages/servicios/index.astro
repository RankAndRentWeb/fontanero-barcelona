---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.tsx';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://mejoresreformasvalencia.es/#business",
  "name": "Reformas en Valencia",
  "url": "https://mejoresreformasvalencia.es",
  "image": "https://mejoresreformasvalencia.es/og-home.webp",
  "telephone": "+34722208131",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Valencia",
    "addressRegion": "Comunitat Valenciana",
    "postalCode": "46000",
    "addressCountry": "ES"
  },
  "openingHours": ["Mo-Sa 08:00-20:00"],
  "priceRange": "€€",
  "areaServed": [{ "@type": "City", "name": "Valencia" }]
};

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Servicios de Reformas en Valencia",
  "itemListElement": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Cocinas en Valencia",
        "description": "Reforma completa de cocinas con diseño, mobiliario, encimeras, revestimientos e iluminación."
      }
    },
    {
      "@type": "Offer", 
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Baños en Valencia",
        "description": "Renovación de baños con sanitarios, plato de ducha, revestimientos y distribución funcional."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service", 
        "name": "Reformas Integrales en Valencia",
        "description": "Reforma completa de viviendas con coordinación global de espacios y acabados."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Pisos en Valencia",
        "description": "Renovación de pisos completos o parciales con redistribución y modernización."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Terrazas en Valencia",
        "description": "Mejora de terrazas con suelo, impermeabilización y aprovechamiento del espacio exterior."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Chalets en Valencia",
        "description": "Reforma de viviendas unifamiliares interior y exterior con actualización completa."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Fachadas en Valencia",
        "description": "Mejora exterior de edificios con reparación, renovación estética y protección."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reformas de Locales Comerciales en Valencia",
        "description": "Acondicionamiento de espacios comerciales con adaptación funcional y mejora de imagen."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Pladur y Techos en Valencia",
        "description": "Instalación de falsos techos, tabiques y trasdosados con pladur y mejora de acabados interiores."
      }
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué tipos de reformas realizáis en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Realizamos reformas de cocinas, baños, reformas integrales, pisos, terrazas, chalets, fachadas, locales comerciales y trabajos de pladur. Ofrecemos presupuesto gratuito en menos de 24 horas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una reforma en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende del tipo de reforma, metros cuadrados y acabados. Una reforma de baño desde 3.500€, cocina desde 4.500€. Te damos presupuesto detallado gratuito tras visitar tu espacio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de cocina o baño?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma de baño completa tarda 10-15 días, una cocina 15-20 días. Reformas integrales según alcance. Te damos calendario detallado y cumplimos plazos."
      }
    },
    {
      "@type": "Question",
      "name": "¿En qué zonas de Valencia trabajáis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Trabajamos en toda Valencia capital y área metropolitana: Torrent, Mislata, Paterna, Burjassot, Manises, Xirivella, Aldaia, Quart de Poblet, Alaquàs y Picanya."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dais factura y garantía?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, siempre. Emitimos factura oficial con IVA y garantía por escrito en todos nuestros trabajos. Contamos con seguro de responsabilidad civil."
      }
    }
  ]
};
---

<SiteLayout 
  title="Servicios de Reformas en Valencia | Tipos de Reformas para Viviendas y Locales"
  description="Conoce nuestros servicios de reformas en Valencia para viviendas y locales: cocinas, baños, reformas integrales, pisos, terrazas, fachadas, chalets, locales comerciales y pladur."
  canonical="https://mejoresreformasvalencia.es/servicios/"
  ogImage="https://mejoresreformasvalencia.es/og-home.webp"
  schema={[localBusinessSchema, offerCatalogSchema, faqSchema]}
>
  <div class="flex-1">
    <!-- Breadcrumbs con fondo azul suave -->
    <div class="bg-blue-50/30">
      <div class="container mx-auto px-4">
        <Breadcrumbs items={[{ label: "Servicios" }]} client:load />
      </div>
    </div>
    
    <!-- Hero / Introducción con fondo azul suave -->
    <div class="bg-blue-50/30 py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Servicios de Reformas en Valencia
          </h1>
          
          <div class="space-y-5 text-gray-700 leading-relaxed">
            <p class="text-lg">
              Somos una <strong>empresa de reformas en Valencia</strong> con más de 10 años de experiencia transformando hogares, negocios y comunidades. Nuestro equipo ofrece <strong>servicios completos de reforma</strong>, adaptados a cada cliente en la ciudad y el área metropolitana.
            </p>
            
            <p class="text-lg">
              Realizamos <strong>reformas de cocinas, baños, integrales, pisos, chalets y locales comerciales</strong>, además de trabajos de pladur, siempre con el compromiso de ofrecer <strong>acabados duraderos</strong>, materiales de calidad y limpieza final. Trabajamos con plazos realistas, presupuestos cerrados sin sorpresas y <strong>garantías por escrito</strong> en todos los trabajos.
            </p>
            
            <p class="text-lg">
              Desde <strong>reformas de cocinas</strong> y <strong>baños</strong> hasta <strong>reformas integrales de viviendas</strong>, <strong>terrazas</strong>, <strong>fachadas</strong> o <strong>acondicionamiento de locales comerciales</strong>, cubrimos las necesidades más habituales de renovación. Te ofrecemos <strong>presupuesto gratuito en menos de 24 horas</strong> y asesoramiento personalizado sin compromiso.
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Resto del contenido con fondo blanco -->
    <div class="container mx-auto px-4">
      <div class="py-8">

              <!-- Grid de Servicios Principales -->
              <section class="py-8">
                <h2 class="text-3xl font-bold text-center mb-4">Nuestros Servicios de Reformas en Valencia</h2>
                <p class="text-center text-gray-600 mb-8 max-w-3xl mx-auto">
                  Ofrecemos servicios completos para todo tipo de proyectos. Trabajamos con materiales de calidad y coordinamos todos los gremios para garantizar un resultado bien terminado.
                </p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              
              <!-- 1. Reformas de Cocinas -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/fugas-agua-barcelona/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Reformas de Cocinas</h3>
                <p class="text-gray-600 mb-4">
                  Renovación completa de cocinas con diseño personalizado, distribución funcional, mobiliario a medida, encimeras, revestimientos, fontanería, electricidad e iluminación. Coordinamos todos los gremios para entregar tu cocina lista para usar. Ideal para modernizar tu hogar y aumentar su valor.
                </p>
                <ul class="mt-3 space-y-2 text-sm text-gray-700">
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Diseño 3D gratuito</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Coordinación total de gremios</span>
                  </li>
                  <li class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                    <span>Garantía en materiales y mano de obra</span>
                  </li>
                </ul>
                <span class="mt-4 w-full h-10 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold inline-flex items-center justify-center">
                  Ver detalles y precios
                </span>
              </a>

              <!-- 2. Reformas de Fachadas -->
              <a class="rounded-lg border bg-white shadow-sm hover:shadow-md transition p-6 block group" href="/servicios/fugas-gas-barcelona/">
                <h3 class="text-xl font-semibold mb-3 group-hover:text-accent transition">Reformas de Fachadas</h3>
                <p class="text-gray-600 mb-4">
                  Mejora exterior de edificios, chalets y locales con reparación de grietas, restauración de revestimientos, impermeabilización, protección anti-humedad y acabado estético duradero. Incluimos andamios certificados, tratamiento de filtraciones y protección contra el clima mediterráneo.
                </p>
