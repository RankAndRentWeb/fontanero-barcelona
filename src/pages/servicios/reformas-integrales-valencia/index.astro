---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import reformaIntegralImg from '../../../assets/reformas-integrales-valencia.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://mejoresreformasvalencia.es/servicios/reformas-integrales-valencia/#service",
  "name": "Reformas Integrales en Valencia",
  "description": "Servicio de reformas integrales en Valencia para viviendas, pisos, chalets y locales, con coordinación de gremios y gestión completa de obra.",
  "url": "https://mejoresreformasvalencia.es/servicios/reformas-integrales-valencia/",
  "serviceType": "Reformas integrales",
  "areaServed": {
    "@type": "City",
    "name": "Valencia",
    "addressCountry": "ES"
  },
  "provider": {
    "@id": "https://mejoresreformasvalencia.es/#business"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una reforma integral en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de una reforma integral en Valencia depende de metros, calidades y alcance del proyecto. Como referencia, una vivienda de 70 m² puede partir desde 18.000€, una de 90 m² desde 25.000€ y proyectos más amplios desde 32.000€. Incluye coordinación de gremios, planificación y ejecución profesional."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma integral?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma integral en Valencia suele tardar entre 6 y 12 semanas según tamaño, redistribución de espacios y complejidad técnica. Antes de empezar, definimos un calendario de obra detallado para que tengas plazos claros desde el primer día."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma integral?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye albañilería, fontanería, electricidad, revestimientos, pavimentos, carpintería, reforma de cocina y baño si forma parte del alcance, además de coordinación de gremios y gestión global del proyecto. Presupuesto cerrado y seguimiento continuo de obra."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reformas Integrales en Valencia | Presupuesto Gratis"
  description="Empresa de reformas integrales en Valencia para viviendas, pisos, chalets y locales. Coordinamos todo el proyecto con presupuesto gratis y ejecución profesional."
  keywords="reformas integrales valencia, empresas reformas integrales valencia, reformas integrales en valencia, empresa de reformas integrales en valencia, reformas de diseño valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reformas-integrales-valencia/"
  schema={[serviceSchema, faqSchema]}
  ogImage="/og-home.webp"
>

    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reformas Integrales" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reformas Integrales en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Reforma completa de viviendas y locales con coordinación de gremios, diseño funcional y ejecución profesional de principio a fin</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 18.000€ <span class="text-sm text-gray-500 font-normal">Proyecto integral</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Coordinación de gremios</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Presupuesto claro</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Gestión global de obra</span>
              </div>
            </div>
          </div>
          
          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={reformaIntegralImg.src} alt="Reforma integral en Valencia con renovación completa de vivienda" width={reformaIntegralImg.width} height={reformaIntegralImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio reformas integrales Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Reformas Integrales en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente según metros, alcance y calidades
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de una reforma integral en Valencia</strong> depende de los metros cuadrados, la redistribución de espacios, el estado inicial del inmueble y las calidades elegidas. En todos los casos trabajamos con presupuesto cerrado y planificación clara, sin sorpresas.
            </p>
            
            <p class="text-lg leading-relaxed">
              Como <strong>empresa de reformas integrales en Valencia</strong>, coordinamos albañilería, fontanería, electricidad, revestimientos, pavimentos y carpintería en una sola obra. También integramos cocina y baño dentro del proyecto si lo necesitas.
            </p>
          </div>

          <!-- Tabla de precios orientativos -->
          <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos de Reformas Integrales en Valencia</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por tipología -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Vivienda Completa</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Piso 70 m²</span>
                    <span class="font-bold text-accent">desde 18.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Piso 90 m²</span>
                    <span class="font-bold text-accent">desde 25.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Chalet 120 m²</span>
                    <span class="font-bold text-accent">desde 32.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye proyecto integral y coordinación completa</p>
              </div>

              <!-- Precio por partidas clave -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Partidas Habituales</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma cocina completa</span>
                    <span class="font-bold text-accent">desde 8.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reforma baño completo</span>
                    <span class="font-bold text-accent">desde 4.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Instalaciones integrales</span>
                    <span class="font-bold text-accent">desde 6.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según estado</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye una Reforma Integral?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Planificación y gestión global de obra</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Albañilería y redistribución de espacios</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Fontanería y electricidad nuevas</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Pavimentos y revestimientos</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Carpintería interior y acabados</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Limpieza final y entrega con garantía</span>
                </div>
              </div>
            </div>

          <div class="mt-8 bg-white rounded-xl p-6">
            <p class="text-lg text-gray-700 mb-6">
              <strong>¿Quieres reformar tu vivienda al completo?</strong> Consulta nuestro presupuesto de <strong>reformas integrales en Valencia</strong> y te ayudamos a definir un proyecto realista, funcional y bien ejecutado.
            </p>
            <div class="flex justify-center text-center">
              <a href="/contacto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent text-white hover:bg-accent/90 focus:ring-accent shadow-md hover:shadow-lg px-8 py-3 text-lg rounded-lg">
                Solicitar Presupuesto Gratuito
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo Ejecutamos Reformas Integrales en Valencia -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-green-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Cómo Trabajamos una Reforma Integral en Valencia
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Proceso paso a paso con planificación, coordinación y ejecución profesional
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <!-- Paso 1 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  1
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Visita Técnica y Definición del Proyecto</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Empezamos con una visita técnica para conocer necesidades, distribución actual y objetivos del cliente. Definimos alcance, calidades y prioridades para una <strong>reforma integral en Valencia</strong> bien planteada desde el inicio.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  2
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Presupuesto Cerrado y Plan de Obra</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Entregamos un presupuesto detallado por partidas y un calendario realista de ejecución. Así sabes qué se hace, cuándo se hace y cuánto cuesta cada fase, sin sorpresas.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    A partir de ahí organizamos los recursos y la secuencia de trabajos para que la obra avance de forma ordenada.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  3
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Ejecución de Obra y Coordinación de Gremios</h3>
                  <p class="text-gray-700 leading-relaxed mb-3">
                    Ejecutamos albañilería, fontanería, electricidad, pavimentos y revestimientos con coordinación continua de gremios. Nos ocupamos de que cada fase entre en tiempo y forma.
                  </p>
                  <p class="text-gray-700 leading-relaxed">
                    Si el proyecto lo requiere, integramos reforma de cocina y baño dentro de la misma planificación.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  4
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Acabados y Revisión de Calidad</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Cerramos la obra con acabados finales, repasos y control de calidad en cada estancia para asegurar funcionalidad, estética y durabilidad.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 5 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  5
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Entrega Final y Garantía</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Entregamos la vivienda o local limpio, revisado y listo para uso. Incluimos garantía por escrito y seguimiento post-obra para que tengas respaldo real.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios de Reformas Integrales en Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Beneficios de una Reforma Integral en Valencia
            </h2>
            <p class="text-xl text-gray-600">
              Mejora funcional, estética y valor real de tu inmueble
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-10">
            <!-- Beneficio 1 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-6">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-2">Vivienda Mejor Aprovechada</h3>
                  <p class="text-gray-700">
                    Una <strong>reforma integral en Valencia</strong> permite redistribuir espacios para ganar comodidad, funcionalidad y mejor circulación en el día a día.
                  </p>
                </div>
              </div>
            </div>

            <!-- Beneficio 2 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-6">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 bg-accent rounded-lg flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 0l-2 2a1 1 0 101.414 1.414L8 10.414l1.293 1.293a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-2">Coordinación Total en un Solo Proyecto</h3>
                  <p class="text-gray-700">
                    Coordinamos todos los oficios para que no tengas que gestionar varios proveedores. Un solo equipo, un calendario y un responsable de obra.
                  </p>
                </div>
              </div>
            </div>

            <!-- Beneficio 3 -->
            <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-xl p-6">
              <div class="flex items-start space-x-4">
