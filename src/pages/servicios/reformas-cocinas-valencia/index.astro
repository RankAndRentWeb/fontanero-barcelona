          <div class="bg-gradient-to-br from-green-50 to-slate-50 rounded-2xl p-8 mb-8">
            <h3 class="text-2xl font-bold mb-6 text-center">Precios Orientativos Reformas de Cocinas</h3>
            
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Precio por tipo de reforma -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Según Tipo de Reforma</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina básica</span>
                    <span class="font-bold text-accent">desde 4.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina completa</span>
                    <span class="font-bold text-accent">desde 8.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina premium</span>
                    <span class="font-bold text-accent">desde 15.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye mobiliario, encimera y alicatado</p>
              </div>

              <!-- Precio por tamaño -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Según Tamaño</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina pequeña (6-8 m²)</span>
                    <span class="font-bold text-accent">desde 4.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina media (9-12 m²)</span>
                    <span class="font-bold text-accent">desde 7.000€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Cocina grande (+12 m²)</span>
                    <span class="font-bold text-accent">desde 10.000€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios varían según acabados</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye una Reforma Integral de Cocina?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
