const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una reforma de cocina en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de una reforma de cocina en Valencia varía según tamaño y calidad. Una cocina básica empieza desde 4.000€, una reforma completa desde 8.000€ y una reforma premium desde 15.000€. Incluye mobiliario, encimeras, revestimientos, fontanería y electricidad. Presupuesto gratuito sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda una reforma de cocina?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma completa de cocina en Valencia tarda entre 10 y 15 días laborables. Esto incluye demolición, fontanería, electricidad, alicatado, instalación de mobiliario y encimeras. El tiempo exacto depende del alcance de la reforma y la complejidad del proyecto."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma integral de cocina?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma integral de cocina en Valencia incluye: demolición de la cocina antigua, instalaciones de fontanería y electricidad nuevas, alicatado de paredes, pavimento, mobiliario a medida con herrajes de calidad, encimera, fregadero, grifería, iluminación LED y conexión de electrodomésticos. Todo llave en mano."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reformas de Cocinas en Valencia | Empresa de Reformas"
  description="Empresa de reformas de cocinas en Valencia. Renovamos distribución, mobiliario, encimeras, suelos e iluminación con acabados profesionales y presupuesto sin compromiso."
  keywords="reformas cocinas valencia, cocina integral valencia, empresas de reformas de cocinas en valencia, reforma integral cocina valencia, reformas de cocina valencia, reformas cocinas y baños valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reformas-cocinas-valencia/"
  schema={[kitchenServiceSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <div class="flex-1">
    <!-- Breadcrumbs and Hero Section -->
      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reformas de Cocinas" }
            ]}  client:load />
      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reformas de Cocinas en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Renovamos tu cocina con mobiliario, encimeras y acabados profesionales</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 4.000€ <span class="text-sm text-gray-500 font-normal">Cocina completa</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
            <!-- Features -->
            <div class="space-y-2">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Diseño 3D gratuito</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Mobiliario incluido</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-700">Garantía total</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={cocinaInteriorImg.src} alt="Reforma de cocina en Valencia - Cocina moderna con mobiliario blanco y encimera" width={cocinaInteriorImg.width} height={cocinaInteriorImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
            </div>
          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- Precio reforma cocina Valencia -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precios de Reformas de Cocinas en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente desde 4.000€ con mobiliario, encimeras y acabados incluidos
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700 mb-10">
            <p class="text-lg leading-relaxed">
              El <strong>precio de una reforma de cocina en Valencia</strong> depende del tamaño, la calidad de los materiales, el mobiliario elegido y el alcance de la reforma. Ofrecemos presupuestos cerrados y transparentes, sin sorpresas ni costes ocultos.
            </p>
            
            <p class="text-lg leading-relaxed">
              Nuestras <strong>reformas de cocinas en Valencia</strong> incluyen coordinación total de gremios (fontanería, electricidad, alicatado, carpintería), materiales de calidad contrastada y acabados profesionales que transforman tu cocina en un espacio funcional y moderno.
            </p>
          </div>

