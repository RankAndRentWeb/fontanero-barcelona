---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import reformaLocalImg from '../../../assets/reformas-locales-comerciales-valencia.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://mejoresreformasvalencia.es/servicios/reformas-locales-comerciales-valencia/#service",
  "name": "Reformas de Locales Comerciales en Valencia",
  "description": "Servicio de reformas de locales comerciales en Valencia para acondicionar espacios de negocio con enfoque funcional y ejecución profesional.",
  "url": "https://mejoresreformasvalencia.es/servicios/reformas-locales-comerciales-valencia/",
  "serviceType": "Reformas de locales comerciales",
  "areaServed": {
    "@type": "City",
    "name": "Valencia",
    "addressCountry": "ES"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta reformar un local comercial en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende de metros, estado y alcance. Un acondicionamiento parcial puede partir desde 9.000€ y una reforma integral desde 18.000€. Entregamos presupuesto sin compromiso y con partidas detalladas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de local?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma parcial suele durar entre 2 y 4 semanas. Una reforma integral puede estar entre 5 y 10 semanas según complejidad. Organizamos plazos para reducir al máximo el impacto en la actividad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma de local comercial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye demolición, redistribución, instalaciones eléctricas y fontanería, suelos, revestimientos, techos y acabados finales. Adaptamos el proyecto a la actividad y al flujo real del negocio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacéis acondicionamiento para distintos tipos de negocio y adaptáis distribución e instalaciones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Hacemos acondicionamiento de locales comerciales Valencia para tiendas, oficinas, clínicas, restauración y otros negocios, adaptando distribución, instalaciones y acabados en Valencia capital y alrededores."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reformas de Locales Comerciales en Valencia | Presupuesto Gratis"
  description="Empresa especializada en reformas de locales comerciales en Valencia. Acondicionamos espacios para negocios con presupuesto gratis, ejecución profesional y enfoque funcional."
  keywords="reformas locales comerciales valencia, reforma de local comercial en valencia, empresa de reformas de locales comerciales en valencia, acondicionamiento de locales comerciales valencia, reforma integral local comercial valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reformas-locales-comerciales-valencia/"
  schema={[serviceSchema, faqSchema]}
  includeBusinessSchema={false}
  ogImage="/og-home.webp"
>
    <!-- Breadcrumbs and Hero Section -->
    <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
      <div class="container mx-auto px-4">
        <Breadcrumbs items={[
            { label: "Servicios", href: "/servicios/" },
            { label: "Reformas de Locales Comerciales" }
          ]} client:load />
      </div>

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <!-- Left side - Content -->
            <div>
              <!-- Title -->
              <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reformas de Locales Comerciales en Valencia</h1>
              
              <!-- Subtitle -->
              <p class="text-xl text-gray-700 mb-6">Reformamos y acondicionamos locales comerciales con enfoque funcional, imagen cuidada y plazos organizados para afectar lo mínimo al negocio</p>
              
              <!-- Price -->
              <div class="mb-6">
                <span class="text-2xl font-bold text-accent">desde 9.000€ <span class="text-sm text-gray-500 font-normal">Reforma parcial</span></span>
              </div>
              
              <!-- CTAs -->
              <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="/contacto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                  Presupuesto Gratis
                </a>
                <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                  </svg>
                  722 208 131
                </a>
              </div>
              
              <!-- Features -->
              <div class="space-y-2">
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Acondicionamiento funcional</span>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Plazos organizados</span>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700">Ejecución profesional</span>
                </div>
              </div>
            </div>
            
            <!-- Right side - Image -->
            <div class="order-first lg:order-last">
              <div class="relative rounded-2xl overflow-hidden shadow-xl">
                <img src={reformaLocalImg.src} alt="Reforma de local comercial en Valencia con acondicionamiento profesional" width={reformaLocalImg.width} height={reformaLocalImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio y Condiciones -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Precio de Reformas de Locales Comerciales en Valencia
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Presupuesto transparente según alcance y necesidades del negocio
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700">
            <p class="text-lg leading-relaxed">
              El <strong>precio de una reforma de local comercial en Valencia</strong> depende de los metros, el estado actual del espacio y el tipo de adaptación que necesita el negocio. En todos los casos trabajamos con <strong>presupuesto cerrado, detallado y transparente</strong>.
            </p>
            
            <p class="text-lg leading-relaxed">
              Organizamos la obra por fases para reducir al máximo el impacto en la actividad. Realizamos <strong>acondicionamiento de locales comerciales Valencia</strong> adaptando distribución, instalaciones y acabados según cada negocio:
            </p>

            <ul class="space-y-3 ml-6">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Clínicas y consultas:</strong> distribución funcional, instalaciones técnicas y acabados higiénicos</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Hostelería:</strong> adaptación de sala, barra, cocina y zonas de servicio</span>
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1 mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span><strong>Tiendas y oficinas:</strong> reforma de imagen comercial, iluminación y recorridos de cliente</span>
              </li>
            </ul>

            <p class="text-lg leading-relaxed">
              El precio incluye <strong>demolición, albañilería, instalaciones, suelos, revestimientos, techos y acabados finales</strong> según proyecto. Te acompañamos de principio a fin.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Proceso Paso a Paso -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-green-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Nuestro Proceso de Reforma Paso a Paso
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Así trabajamos para reformar tu local con plazos organizados y ejecución profesional
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="space-y-8">
            <!-- Paso 1 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  1
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Visita Técnica y Definición de Proyecto</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Visitamos el local para analizar distribución, instalaciones y necesidades del negocio. Definimos una propuesta realista para una <strong>reforma integral local comercial Valencia</strong> o parcial, según tu objetivo.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 2 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  2
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Plan de Obra y Organización de Plazos</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Marcamos fases, tiempos y prioridades para afectar lo mínimo a la actividad. Si el negocio está en marcha, organizamos el trabajo para mantener operativas las zonas clave.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 3 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  3
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Demolición y Adaptación del Espacio</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Ejecutamos demoliciones controladas, redistribución de tabiques y preparación de base para adaptar el local al funcionamiento real del negocio.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 4 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  4
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Instalaciones y Acabados Técnicos</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Renovamos instalaciones eléctricas y fontanería, techos, suelos y revestimientos. Ajustamos cada solución al tipo de actividad y normativa aplicable.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 5 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  5
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Revisión y Ajustes Finales</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Revisamos detalles de ejecución, funcionalidad y remates para que el local quede listo para operar con imagen renovada y buen rendimiento diario.
                  </p>
                </div>
              </div>
            </div>

            <!-- Paso 6 -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-accent text-white rounded-full flex items-center justify-center text-base font-bold">
                  6
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-xl text-gray-900 mb-3">Entrega y Garantía</h3>
                  <p class="text-gray-700 leading-relaxed">
                    Entregamos el local limpio y con garantía por escrito. Te explicamos cada partida ejecutada para que tengas control total del resultado.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Contact Section -->
    <section class="py-12 bg-primary text-white">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">¿Necesitas reformar tu local comercial?</h2>
        <p class="text-xl mb-8">Te respondemos en menos de 24 horas</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto/" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-accent text-white hover:bg-accent/90 focus:ring-accent shadow-md hover:shadow-lg px-6 py-3 text-lg rounded-lg">
            Pedir presupuesto gratis
          </a>
          <a href="tel:+34722208131" class="inline-flex items-center justify-center font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 bg-white text-primary hover:bg-gray-100 focus:ring-primary shadow-md hover:shadow-lg px-6 py-3 text-lg rounded-lg gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
            </svg>
            722 208 131
          </a>
        </div>
      </div>
    </section>
    
    <!-- FAQ -->
    <section class="py-16 bg-gradient-to-br from-slate-50 to-green-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Preguntas Frecuentes sobre Reformas de Locales Comerciales
          </h2>
          <p class="text-lg text-gray-600">
            Resolvemos todas tus dudas sobre nuestro servicio profesional
          </p>
        </div>

        <div class="max-w-4xl mx-auto space-y-6">
          <!-- FAQ 1 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Cuánto cuesta reformar un local comercial en Valencia?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              El precio depende de metros, estado y alcance. Un acondicionamiento parcial puede partir desde 9.000€ y una reforma integral desde 18.000€. Entregamos <strong>presupuesto sin compromiso</strong> y con partidas detalladas.
            </p>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Cuánto tarda una reforma de local?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              Una reforma parcial suele durar entre 2 y 4 semanas. Una reforma integral puede estar entre 5 y 10 semanas según complejidad. Organizamos plazos para reducir al máximo el impacto en la actividad.
            </p>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Qué incluye una reforma de local comercial?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              Incluye demolición, redistribución, instalaciones eléctricas y fontanería, suelos, revestimientos, techos y acabados finales. Adaptamos el proyecto a la actividad y al flujo real del negocio.
            </p>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-white border-2 border-gray-100 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-xl mb-3 text-gray-900">
              ¿Hacéis acondicionamiento para distintos tipos de negocio y adaptáis distribución e instalaciones?
            </h3>
            <p class="text-gray-700 leading-relaxed">
              Sí. Hacemos <strong>acondicionamiento de locales comerciales Valencia</strong> para tiendas, oficinas, clínicas, restauración y otros negocios, adaptando distribución, instalaciones y acabados en Valencia capital y alrededores.
            </p>
          </div>
        </div>
      </div>
    </section>
</SiteLayout>
