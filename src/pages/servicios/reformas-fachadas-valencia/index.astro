const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta una reforma de fachada en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio de reformar una fachada en Valencia depende del estado, altura y metros cuadrados. Una rehabilitación básica (saneado y reparación) parte desde 1.500€. Una reforma completa con nuevo revestimiento e impermeabilización parte desde 4.500€. La rehabilitación de un edificio completo puede superar los 9.000€. Ofrecemos presupuesto gratuito sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una rehabilitación de fachada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El tiempo de una rehabilitación de fachada en Valencia varía según el alcance. Un trabajo de saneado y reparación de grietas en una fachada de 100m² suele tomar entre 5 y 10 días. Una rehabilitación completa con revestimiento nuevo puede tardar entre 2 y 4 semanas, según la complejidad y altura del edificio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma integral de fachada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma integral de fachada en Valencia incluye: inspección y diagnóstico del estado, saneado y picado de zonas deterioradas, reparación de grietas y fisuras, impermeabilización, aplicación de nuevo revestimiento exterior, tratamiento anti-humedad y acabado estético. Todo con garantía y cumplimiento de normativa vigente."
      }
    }
  ]
};
---

<SiteLayout 
  title="Reformas de Fachadas en Valencia | Presupuesto Gratis"
  description="Empresa especializada en reformas de fachadas en Valencia. Rehabilitación, reparación, impermeabilización y mejora exterior de edificios con presupuesto gratis."
  keywords="reformas fachadas valencia, reforma de fachadas en valencia, empresas de reformas de fachadas en valencia, rehabilitación de fachadas valencia, renovación de fachadas valencia, reparación de fachadas valencia"
  canonical="https://mejoresreformasvalencia.es/servicios/reformas-fachadas-valencia/"
  schema={[localBusinessSchema, faqSchema]}
  ogImage="/og-home.webp"
>
  <main class="flex-1">
    <!-- Breadcrumbs and Hero Section -->

      <section class="bg-gradient-to-br from-slate-50 to-green-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[
              { label: "Servicios", href: "/servicios/" },
              { label: "Reformas de Fachadas" }
            ]}  client:load />
  

      

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <!-- Left side - Content -->
          <div>
            <!-- Title -->
            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Reformas de Fachadas en Valencia</h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-gray-700 mb-6">Rehabilitación, saneado e impermeabilización de fachadas con garantía y presupuesto cerrado. Trabajamos en edificios, comunidades y viviendas.</p>
            
            <!-- Price -->
            <div class="mb-6">
              <span class="text-2xl font-bold text-accent">desde 1.500€ <span class="text-sm text-gray-500 font-normal">Fachada completa</span></span>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="/presupuesto/" class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center">
                Presupuesto Gratis
              </a>
              <a href="tel:+34722208131" class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
