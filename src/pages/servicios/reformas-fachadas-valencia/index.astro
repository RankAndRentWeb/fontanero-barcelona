                </svg>
                <span class="text-gray-700">Garantía 5 años</span>
              </div>
            </div>
          </div>

          <!-- Right side - Image -->
          <div class="order-first lg:order-last">
            <div class="relative rounded-2xl overflow-hidden shadow-xl">
              <img src={fachadaExteriorImg.src} alt="Reforma de fachada en Valencia - Rehabilitación exterior de edificio" width={fachadaExteriorImg.width} height={fachadaExteriorImg.height} class="w-full h-auto object-cover" loading="eager" fetchpriority="high">
