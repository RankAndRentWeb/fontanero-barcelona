                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fachada 100 m²</span>
                    <span class="font-bold text-accent">desde 1.500€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fachada 150 m²</span>
                    <span class="font-bold text-accent">desde 2.100€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Fachada 200 m²</span>
                    <span class="font-bold text-accent">desde 2.800€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Incluye saneado, reparación y revestimiento</p>
              </div>

              <!-- Precio por zonas -->
              <div class="bg-white rounded-xl p-6 shadow-sm">
                <h4 class="font-bold text-lg mb-4 text-gray-900">Por Zonas Específicas</h4>
                <ul class="space-y-3">
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Reparación puntual de grietas</span>
                    <span class="font-bold text-accent">desde 200€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Saneado de patio interior</span>
                    <span class="font-bold text-accent">desde 350€</span>
                  </li>
                  <li class="flex justify-between items-center">
                    <span class="text-gray-700">Rehabilitación fachada portal</span>
                    <span class="font-bold text-accent">desde 600€</span>
                  </li>
                </ul>
                <p class="text-sm text-gray-500 mt-4">*Precios pueden variar según estado</p>
              </div>
            </div>

            <!-- Qué incluye el precio -->
            <div class="mt-8 bg-white rounded-xl p-6">
              <h4 class="font-bold text-lg mb-4 text-gray-900">¿Qué Incluye el Precio de Reforma de Fachada?</h4>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
