---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.tsx';
import pladurTechosImg from '../../../assets/reformas-pladur-y-techos-valencia.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://mejoresreformasvalencia.es/servicios/pladur-techos-valencia/#service",
  "name": "Pladur y Techos en Valencia",
  "description": "Servicio de pladur y techos en Valencia para instalar falsos techos, tabiques y trasdosados con acabados profesionales.",
  "url": "https://mejoresreformasvalencia.es/servicios/pladur-techos-valencia/",
  "serviceType": "Pladur y techos",
  "areaServed": {
    "@type": "City",
    "name": "Valencia",
    "addressCountry": "ES"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta instalar un techo de pladur en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende de la superficie, altura, complejidad y acabados. Como referencia, la instalación de techos de pladur en Valencia parte desde 32€/m². Entregamos presupuesto detallado y sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda un trabajo de pladur y techos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depende de los metros y del tipo de solución. Un falso techo estándar suele ejecutarse en 1 a 3 días por estancia, y un proyecto con tabiques o trasdosados puede requerir entre 3 y 7 días. Planificamos por fases para reducir molestias."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye un falso techo y hacéis tabiques y trasdosados con aislamiento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye estructura metálica, placas de pladur, juntas, remates y acabado listo para terminación final. También realizamos tabiques y trasdosados con aislamiento térmico y acústico. Trabajamos en Valencia capital y alrededores con presupuesto sin compromiso."
      }
    }
  ]
};
