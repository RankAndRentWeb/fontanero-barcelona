const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta reformar un chalet en Valencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El precio depende de los metros, el estado del chalet y el alcance de la reforma. Una reforma parcial puede partir desde 18.000€, una reforma integral de 120m² desde 35.000€ y proyectos de mayor tamaño desde 52.000€. Ofrecemos presupuesto sin compromiso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda una reforma de chalet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una reforma parcial suele durar entre 4 y 8 semanas. Una reforma integral de chalet puede tardar entre 10 y 18 semanas, según redistribución de espacios y trabajos exteriores. Definimos un calendario de obra claro desde el inicio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué incluye una reforma integral de chalet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye demolición, albañilería, fontanería, electricidad, suelos, revestimientos, carpintería, renovación de cocina y baños, y mejora de zonas exteriores si está en alcance. Todo coordinado por un único equipo técnico."
      }
    },
    {
      "@type": "Question",
      "name": "¿Renováis interior y exterior, incluyendo terrazas o porches?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Realizamos renovación interior y exterior de chalets, incluyendo terrazas, porches y otras zonas exteriores, con soluciones duraderas y acabados profesionales."
      }
    }
  ]
};
