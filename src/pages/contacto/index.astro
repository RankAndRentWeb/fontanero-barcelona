---

<SiteLayout 
  title="Contacto | Reformas en Valencia | Presupuesto en 24h"
  description="Contacta con nuestro equipo de reformas en Valencia. Solicita presupuesto gratis. Tel: 722 208 131. Atendemos Valencia capital y alrededores."
  keywords="contacto reformas valencia, telefono reformas valencia, presupuesto reforma"
  schema={[localBusinessSchema]}
>
  <main>
    <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <div class="container mx-auto px-4">
        <Breadcrumbs items={[{ label: "Contacto" }]} client:load />

        <div class="py-12">
          <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold mb-6">
              Llámanos o escríbenos ahora
            </h1>
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
              Presupuesto gratuito en menos de 24 horas. Empresa de reformas en toda Valencia.
            </p>
          </div>

          <!-- Contenido: acciones + formulario -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Bloque izquierdo (diseño original) -->
            <div class="space-y-8">
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="https://wa.me/34722208131"
                  aria-label="Contactar por WhatsApp"
                  class="h-11 px-6 rounded-md bg-green-500 hover:bg-green-600 text-white font-semibold shadow inline-flex items-center justify-center gap-2 transition"
                >
                  <svg
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      d="M.057 11.95C.057 5.355 5.456 0 12.114 0c3.233 0 6.188 1.25 8.436 3.515 2.25 2.27 3.498 5.255 3.498 8.447 0 6.596-5.4 11.952-12.057 11.952-2.09 0-4.132-.522-5.94-1.515L0 24l1.627-5.313A11.86 11.86 0 0 1 .057 11.95Z"
                    />
                  </svg>
                  WhatsApp
                </a>
                <a
                  href="tel:+34722208131"
                  aria-label="Llamar ahora"
                  class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold shadow inline-flex items-center justify-center gap-2 transition"
                >
                  <svg
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <path
                      d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                    />
                  </svg>
                  Llamar ahora
                </a>
              </div>

              <div class="space-y-2">
                <div class="flex items-center space-x-3">
                  <span
                    class="inline-flex items-center justify-center w-5 h-5 bg-green-500 text-white rounded-full text-xs font-bold"
                    >✓</span
                  >
                  <span class="text-gray-700">Respuesta en menos de 24 horas</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span
                    class="inline-flex items-center justify-center w-5 h-5 bg-green-500 text-white rounded-full text-xs font-bold"
                    >✓</span
                  >
                  <span class="text-gray-700">Limpieza incluida</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span
                    class="inline-flex items-center justify-center w-5 h-5 bg-green-500 text-white rounded-full text-xs font-bold"
                    >✓</span
                  >
                  <span class="text-gray-700">Presupuesto claro y sin compromiso</span>
                </div>
                <div class="flex items-center space-x-3">
                  <span
                    class="inline-flex items-center justify-center w-5 h-5 bg-green-500 text-white rounded-full text-xs font-bold"
                    >✓</span
                  >
                  <span class="text-gray-700">Coordinación profesional de la obra</span>
                </div>
              </div>

              <p class="text-sm text-gray-500">
                Email: info@mejoresreformasvalencia.es
              </p>
            </div>

            <!-- Columna derecha: NUEVO formulario React -->
            <Contacto client:load />
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
