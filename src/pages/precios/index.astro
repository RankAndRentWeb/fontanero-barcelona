                  <p class="text-gray-600 text-sm">
                    Proyecto integral con redistribución, instalaciones, suelos, carpintería y acabados finales.
                  </p>
                </div>
                <div class="text-right">
                  <div class="text-2xl font-bold text-accent">28.000–55.000 €</div>
                </div>
              </div>
            </div>

            <!-- Reforma Parcial Piso -->
