---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.tsx';

const pricesPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://mejoresreformasvalencia.es/precios/#webpage",
  "url": "https://mejoresreformasvalencia.es/precios/",
  "name": "Precios de Reformas en Valencia",
  "description": "Precios orientativos de reformas en Valencia para cocina, baño, pisos, locales y reformas integrales.",
  "mainEntity": {
    "@id": "https://mejoresreformasvalencia.es/precios/#offers"
  }
};

const offerCatalogSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "@id": "https://mejoresreformasvalencia.es/precios/#offers",
  "name": "Precios orientativos de reformas en Valencia",
  "url": "https://mejoresreformasvalencia.es/precios/",
  "itemListElement": [
    {
      "@type": "Offer",
      "name": "Reforma de cocina",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "EUR",
        "minPrice": "4500",
        "maxPrice": "12000",
        "description": "Rango orientativo"
      }
    },
    {
      "@type": "Offer",
      "name": "Reforma de baño",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "EUR",
        "minPrice": "3500",
        "maxPrice": "8500",
        "description": "Rango orientativo"
      }
    },
    {
      "@type": "Offer",
      "name": "Reforma integral piso 100 m²",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "EUR",
        "minPrice": "28000",
        "maxPrice": "55000",
        "description": "Rango orientativo"
      }
    },
    {
      "@type": "Offer",
      "name": "Reforma parcial de piso",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "EUR",
        "minPrice": "9000",
        "maxPrice": "22000",
        "description": "Rango orientativo"
      }
    },
    {
      "@type": "Offer",
      "name": "Reforma de local comercial",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "priceCurrency": "EUR",
        "minPrice": "12000",
        "description": "Precio orientativo desde"
      }
    }
  ]
};
---

<SiteLayout 
  title="Precios de Reformas en Valencia | Presupuesto Gratis"
  description="Consulta precios orientativos de reformas en Valencia: cocinas, baños, pisos y reformas integrales. Presupuesto gratis, opciones ajustadas y financiación disponible."
  keywords="reformas valencia precios, presupuesto reforma valencia, presupuesto reformas valencia, precio reforma cocina valencia, presupuesto reforma baño valencia, presupuesto reforma integral valencia, reforma integral valencia precios, reformas economicas valencia, reformas financiadas valencia, reformas en valencia presupuestos"
  canonical="https://mejoresreformasvalencia.es/precios/"
  schema={[pricesPageSchema, offerCatalogSchema]}
  includeBusinessSchema={false}
  ogImage="/og-home.webp"
>
    <!-- Breadcrumbs and Hero Section -->
    <section class="bg-gradient-to-br from-slate-50 to-blue-50">
      <!-- Breadcrumbs -->
        <div class="container mx-auto px-4">
          <Breadcrumbs items={[{ label: "Precios" }]} client:load />
  

      <!-- Hero Content -->
      <div class="py-12">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center">
            <!-- Title -->
            <h1 class="text-4xl md:text-5xl font-bold mb-6">
              Precios de Reformas en Valencia
            </h1>
            
            <!-- Subtitle -->
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
              Consulta rangos orientativos para cocina, baño, piso y reforma integral. Te ayudamos a planificar tu proyecto con presupuesto claro y realista.
            </p>
            
            <!-- Price highlight -->
            <div class="mb-6">
              <p class="text-lg font-semibold text-accent">
                Desde 3.500 € <span class="text-sm text-gray-500 font-normal">(reformas de baño)</span>
              </p>
              <p class="text-sm text-gray-500">
                Precios orientativos para Valencia y alrededores. El presupuesto final se define tras visita técnica, mediciones y elección de calidades.
              </p>
            </div>
            
            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
              <a
                href="/contacto/"
                class="h-11 px-6 rounded-md bg-accent hover:bg-accent/90 text-white font-semibold shadow flex items-center justify-center"
              >
                Solicitar presupuesto gratis
              </a>
              <a
                href="tel:+34722208131"
                class="h-11 px-6 rounded-md bg-primary hover:bg-primary/90 text-white font-semibold inline-flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                722 208 131
              </a>
            </div>
            
           
          </div>
        </div>
      </div>
    </section>

    <!-- Tarifas por servicio -->
    <section class="py-12 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">
              Tarifas por servicio
            </h2>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
              Rangos orientativos para reformas con enfoque práctico y transparente
            </p>
          </div>
          
          <div class="space-y-6 text-gray-700">
            <p class="text-lg leading-relaxed">
              Los precios de reformas dependen del alcance, estado inicial del inmueble, materiales elegidos y complejidad de instalaciones.
              Por eso trabajamos con rangos orientativos y presupuesto personalizado tras visita.
            </p>
            
            <p class="text-lg leading-relaxed">
              Todos los presupuestos se entregan por partidas, con importes claros y sin letra pequeña.
              También disponemos de opciones de financiación para distribuir la inversión en plazos cómodos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Listado de precios -->
    <section class="py-12 bg-gray-100">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
